---
import MercadoPagoButton from '../payment/MercadoPagoButton.jsx';
import PaymentInfo from '../payment/PaymentInfo.jsx';

const paymentMethods = [
  { id: 'card', name: 'Tarjeta de Crédito/Débito', icon: '💳' },
  { id: 'transfer', name: 'Transferencia Bancaria', icon: '🏦' },
  { id: 'mercadopago', name: 'Mercado Pago', icon: '📲' },
];
---

<div class="max-w-2xl mx-auto p-6 brutalist-border bg-kaya-dark/50">
  <h2 class="text-2xl font-bold mb-6">Método de Pago</h2>
  
  <div class="space-y-4">
    {paymentMethods.map((method) => (
      method.id === 'mercadopago' ? (
        <div>
        <MercadoPagoButton 
          client:visible
          title="Cuadro Abstracto Premium" 
          price={15000}
          quantity={1}
        />
        </div>
      ) : (
        <a 
          href={method.id === 'card' 
            ? `/galeria/pago/card-credit?method=${method.id}` 
            : method.id === 'transfer' 
              ? `/galeria/pago/informacion-pago?method=${method.id}` 
              : `/galeria/pago/metodo-pago?method=${method.id}`
          }
          class="w-full brutalist-border p-4 flex items-center space-x-4 hover:text-kaya-accent block text-inherit no-underline"
        >
          <span class="text-2xl">{method.icon}</span>
          <span class="font-mono">{method.name}</span>
        </a>
      )
    ))}
  </div>
</div>

<script>
  // Optional: If you want to handle method selection via JavaScript
  document.querySelectorAll('.payment-method').forEach(method => {
    method.addEventListener('click', (e) => {
      const methodId = e.currentTarget.dataset.method;
      // You can add additional logic here if needed
      window.location.href = `/galeria/pago/informacion-pago?method=${methodId}`;
    });
  });
</script>